# Copia este archivo como .env y pega los datos de tu proyecto Supabase
# (Supabase > Project Settings > API Keys). Usa SOLO la llave publicable (sb_publishable_…),
# nunca la secreta. Sin estas variables la app funciona en "modo demo": guarda solo en este navegador.
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_...
